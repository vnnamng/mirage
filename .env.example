# Copy to .env (gitignored) or export in your shell before `npm run test:agent`.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used by the deepagents test.
# MIRAGE_TEST_MODEL=claude-sonnet-5
# Required only for organization-level keys that are not scoped to a workspace
# (the API returns 400 "must include the anthropic-workspace-id header").
# Find it in the Anthropic Console under Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
